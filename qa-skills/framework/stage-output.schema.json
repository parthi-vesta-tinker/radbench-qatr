{
  "$defs": {
    "Anchor": {
      "additionalProperties": false,
      "properties": {
        "section_id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Section Id",
          "type": "string"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "section_id",
        "quote"
      ],
      "title": "Anchor",
      "type": "object"
    },
    "Candidate": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Candidate Id",
          "type": "string"
        },
        "check_id": {
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "title": "Check Id",
          "type": "string"
        },
        "issue_code": {
          "pattern": "^[A-Z][A-Z_]*$",
          "title": "Issue Code",
          "type": "string"
        },
        "finding_type": {
          "enum": [
            "suggestion",
            "discrepancy"
          ],
          "title": "Finding Type",
          "type": "string"
        },
        "comment": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Comment",
          "type": "string"
        },
        "anchors": {
          "items": {
            "$ref": "#/$defs/Anchor"
          },
          "minItems": 1,
          "title": "Anchors",
          "type": "array"
        },
        "basis": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Basis",
          "type": "string"
        },
        "critical_basis": {
          "anyOf": [
            {
              "$ref": "#/$defs/CriticalBasis"
            },
            {
              "type": "null"
            }
          ]
        },
        "requirement_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/Requirement"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "candidate_id",
        "check_id",
        "issue_code",
        "finding_type",
        "comment",
        "anchors",
        "basis",
        "critical_basis",
        "requirement_ref"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "CriticalBasis": {
      "additionalProperties": false,
      "properties": {
        "assessment": {
          "enum": [
            "catalog_match",
            "outside_catalog",
            "generic_provisional"
          ],
          "title": "Assessment",
          "type": "string"
        },
        "assertion_support": {
          "enum": [
            "explicit_diagnosis",
            "cautious_semantic_equivalent",
            "descriptor_only_uncertain"
          ],
          "title": "Assertion Support",
          "type": "string"
        },
        "policy_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Policy Id"
        },
        "rule_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rule Id"
        },
        "source_quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Quote"
        },
        "exception_anchors": {
          "items": {
            "$ref": "#/$defs/Anchor"
          },
          "title": "Exception Anchors",
          "type": "array"
        }
      },
      "required": [
        "assessment",
        "assertion_support",
        "policy_id",
        "rule_id"
      ],
      "title": "CriticalBasis",
      "type": "object"
    },
    "Designation": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "documented_flagged",
            "documented_not_flagged",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "anchor": {
          "anyOf": [
            {
              "$ref": "#/$defs/Anchor"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "anchor"
      ],
      "title": "Designation",
      "type": "object"
    },
    "Requirement": {
      "additionalProperties": false,
      "properties": {
        "policy_id": {
          "title": "Policy Id",
          "type": "string"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        }
      },
      "required": [
        "policy_id",
        "rule_id"
      ],
      "title": "Requirement",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "stage": {
      "enum": [
        "language_review",
        "consistency_review",
        "critical_finding_review"
      ],
      "title": "Stage",
      "type": "string"
    },
    "input_problem": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Input Problem"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/Candidate"
      },
      "title": "Observations",
      "type": "array"
    },
    "designation": {
      "anyOf": [
        {
          "$ref": "#/$defs/Designation"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "stage",
    "input_problem",
    "observations",
    "designation"
  ],
  "title": "SkillStageOutput",
  "type": "object"
}
