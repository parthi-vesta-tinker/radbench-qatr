# Copy this file to .env for local development. Never commit your real .env file.

# Demo uses only the supplied synthetic examples and does not call OpenAI.
QA_MODE=demo

# Use a separate local database folder for this developer machine.
QA_DATA_DIR=.qa-data-local
QA_AUTH_MODE=local

# Optional name displayed in Review History for reviews submitted from this machine.
# QA_LOCAL_OPERATOR_NAME=Samson

# Used when QA_MODE=openai.
OPENAI_MODEL=gpt-6-astra
# OPENAI_API_KEY=replace_with_your_key

# Optional review settings.
QA_REASONING_EFFORT=medium
QA_MAX_OUTPUT_TOKENS=6000
