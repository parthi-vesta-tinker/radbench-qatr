# Copy this file to .env for local development. Never commit your real .env file.

# Demo uses only the supplied synthetic examples and does not call OpenAI.
RUN_MODE=demo

# Use a separate local database folder for this developer machine.
DATA_DIR=.qa-data-local
ACCESS_MODE=local

# Optional name displayed in Review History for reviews submitted from this machine.
# LOCAL_OPERATOR_NAME=Samson

# Live core review requires OPENAI_API_KEY. JEV classification runs when its key is configured.
OPENAI_MODEL=gpt-6-astra
# Optional comma-separated model choices offered in Settings.
CORE_REVIEW_MODELS=gpt-6-astra
OPENAI_API_KEY=

# Reasoning effort defaults to Medium and can be changed in Settings.
# Optional server output limit for report review responses.
MAX_OUTPUT_TOKENS=6000
TYPESAFE_API_KEY=
# Optional research-only JEV calibration artifact.
JEV_CALIBRATION_PATH=
